{
  "name": "my-fullstack-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "setup": "cd backend && npm install && cd ../frontend && npm install"
  
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
